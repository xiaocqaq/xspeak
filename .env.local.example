# 复制成 .env.local 后填写。ANTHROPIC_BASE_URL 留空则走官方地址。
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_BASE_URL=
# 生成内容用的模型
LINXI_MODEL=claude-opus-5

# PostgreSQL 连接信息。两种写法二选一，DATABASE_URL 优先。
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=language
PGPASSWORD=
PGDATABASE=language
# DATABASE_URL=postgres://user:password@host:5432/dbname
# 连接池上限，默认 10
PGPOOL_MAX=

# StepFun 语音。只有「畅聊」（端到端实时语音对话）用得到，不填的话其它功能照常。
STEP_API_KEY=
# 上游地址，一般不用改（注意是 step_plan/v1，不是文档写的 v1）
# STEP_REALTIME_URL=wss://api.stepfun.com/step_plan/v1/realtime
